# The whole opening, played as a player would: new game -> Endar Spire (end_m01aa, end_m01ab) -> escape pod ->
# Taris apartment. Not a registered test until it passes end to end; opening.walk is the part that passes today.
# Doors and stops follow the retail recording of the same route (tags only).
# Character: the retail recording's player is the male Scoundrel (appearance 148 is portraits.2da appearance_s, the
# class-2 column), so the run starts on the class screen's first button (--new-game-slot 0). The quick build gives it
# Security ranks, which the locked doors the route meets need.
# Status: new game -> end_m01aa -> end_m01ab (corridor soldiers, end_door01), loots the footlocker next to the damaged
# droid (footlker003: 7 repair parts, 5 computer spikes), reactivates the droid
# and sets patrol mode (3 repair parts; its dialogue entry runs k_pend_droid10, which unlocks end_door05), the droid
# opens end_door05 and kills the five Sith behind it, then end_door04, Carth, the escape pod and StartNewModule STUNT_00.
# Retail evidence (user save Espire-SithGroup played to the pod): door05 stays closed and locked for the player; the
# Sith behind it never open it; the droid in patrol mode does.
# Run:  kotor_engine --new-game --new-game-slot 0 --null --headless --fixed-dt 0.0166667 --walk-godmode --walk-continue
#         --input-script opening_full.walk
autodialogue first
expect module end_m01aa
idle 25
goto end_locker01
use end_locker01
loot
equip all
idle 10
partyselect timeout=60
dialogue first timeout=30
idle 5
leader 0
goto end_door01 stop=1.0 timeout=30
opendoor end_door01
dialogue first timeout=120
leader player
idle 3
goto 38.6,20.7,-1.275 stop=0.8 timeout=60
idle 5
leader 0
goto end_door02 stop=1.5 timeout=30
opendoor end_door02
dialogue first timeout=60
idle 6
leader player
goto end_door02 stop=1.5 timeout=30
unlock end_door02
opendoor end_door02 must
dialogue first timeout=60
idle 6
fight range=25 timeout=120
goto 46.5,47.8,-1.275 stop=0.8 timeout=60
use end_door05
fight range=25 timeout=120
goto 47.5,58,-1.275 stop=0.8 timeout=60
use footlker
loot
use metalbox
loot
goto 44.2,65,-1.275 stop=0.6 timeout=60
use end_door10_cut2
dialogue first timeout=60 optional
fight range=25 timeout=120
goto end_door06 stop=1.5 timeout=60
fight range=25 timeout=120
goto end_door16 stop=1.5 timeout=60
unlock end_door16
use end_door16
dialogue first timeout=60 optional
fight range=22 timeout=180
dialogue first timeout=60 optional
fight range=22 timeout=180
# end_door08 is locked and keyed (its lock cannot be picked); the soldiers behind it cannot be shot through the closed
# door (retail 005bbbf0 casts 0050c330, which hits closed doors). Each try runs its OnFailToOpen script (k_pend_door20:
# the bridge-seal sequence, which ends in SetLocked(door, FALSE) + ActionOpenDoor), which unlocks
# the door after a delay (retail recording: tries, then it opens).
goto end_door08 stop=1.5 timeout=90
opendoor end_door08
dialogue first timeout=90 optional
idle 20
opendoor end_door08
dialogue first timeout=90 optional
idle 20
opendoor end_door08
dialogue first timeout=90 optional
fight range=25 timeout=180
dialogue first timeout=90 optional
opendoor end_door08 must
goto end_door15 stop=1.5 timeout=90
opendoor end_door15
dialogue first timeout=60 optional
fight range=22 timeout=180
goto end_door10 stop=1.5 timeout=90
use end_door10
module end_m01ab timeout=60
dialogue first timeout=60 optional
idle 3
goto end_door01 stop=1.5 timeout=90
use end_door01
fight range=14 timeout=90
idle 2
autodialogue off
use footlker
loot
talk end_assaultdroid timeout=60
dialogue index 1 1 1 timeout=90
autodialogue first
idle 30
goto end_door04 stop=1.5 timeout=120
use end_door04
dialogue first timeout=60 optional
use end_pod
dialogue first timeout=120
module STUNT_00 timeout=60
end
