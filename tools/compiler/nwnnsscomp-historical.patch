+void CNscCodeGenerator::GatherUsedArguments (unsigned char *pauchData,
+                                            size_t nDataSize)
+{
+    //
+    // The historical compiler discovered callees in call arguments from
+    // right to left.  Reproduce that order so function address assignment
+    // matches the shipped scripts.  Code generation itself is unchanged.
+    //
+
+    CNwnArray <size_t> anOffsets;
+    CNwnArray <size_t> anSizes;
+    size_t nOffset = 0;
+    while (nOffset < nDataSize)
+    {
+        NscPCodeHeader *pHeader = (NscPCodeHeader *) &pauchData [nOffset];
+        anOffsets .Add (nOffset);
+        anSizes .Add (pHeader ->nOpSize);
+        nOffset += pHeader ->nOpSize;
+    }
+    for (size_t i = anOffsets .GetCount (); i > 0; i--)
+    {
+        GatherUsed (&pauchData [anOffsets [i - 1]], anSizes [i - 1]);
+    }
+}
+
 void CNscCodeGenerator::GatherUsed (unsigned char *pauchData, size_t nDataSize)
 {
 
